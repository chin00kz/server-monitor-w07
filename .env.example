# Non-secret settings. Copy to .env: cp .env.example .env
# The dashboard is published ONLY on this IP (your Tailscale IP), never on all interfaces.
BIND_IP=YOUR_TAILSCALE_IP
APP_UID=1000
APP_GID=1000
DOCKER_CONTROL_CONTAINERS=imfs-pg-m1,imfs-pg-m2,imfs-pg-m3,imfs-pg-m4,imfs-pg-integration,homelab-test,homelab-ollama
