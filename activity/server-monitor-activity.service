[Unit]
Description=Server Monitor W07 Activity Collector Daemon
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=chinookz
Group=chinookz
WorkingDirectory=/home/chinookz/homelab/docker/server-monitor
ExecStart=/usr/bin/python3 activity/collect.py --daemon
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

